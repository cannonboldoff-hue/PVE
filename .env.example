OPENROUTER_API_KEY=
# Must support response_format json_schema and tool calling
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
TWELVELABS_API_KEY=
# Optional: cookies.txt for yt-dlp (Instagram often needs it)
YTDLP_COOKIES=
# Optional video AI. Free-tier content may be used for training: only use on reels you own.
GEMINI_API_KEY=
# Pick from the models the key can list; leave empty to stay on Pegasus
GEMINI_MODEL=
# gemini or pegasus (default: gemini when key and model are set, else pegasus)
VLM_PROVIDER=
# 1 keeps data/refs/<key>/proxy.mp4 after template validation (development)
PVE_KEEP_REFS=
